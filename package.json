{
  "name": "mynoosaheads",
  "version": "3.0.0-sprint-1.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "preview": "npx @opennextjs/cloudflare build && wrangler dev",
    "deploy": "npx @opennextjs/cloudflare build && wrangler deploy",
    "opennext:build": "CF_PAGES=1 npx @opennextjs/cloudflare build",
    "opennext:dev": "CF_PAGES=1 npx @opennextjs/cloudflare build && wrangler dev",
    "opennext:deploy": "CF_PAGES=1 npx @opennextjs/cloudflare build && wrangler deploy",
    "pages:build": "npx @cloudflare/next-on-pages@1.13.0",
    "pages:deploy": "wrangler pages deploy .vercel/output/static --project-name mynoosaheads",
    "pages:dev": "wrangler pages dev .vercel/output/static"
  },
  "dependencies": {
    "@sentry/nextjs": "^8.55.2",
    "gray-matter": "4.0.3",
    "next": "14.2.15",
    "next-mdx-remote": "6.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@mdx-js/react": "3.1.0",
    "@opennextjs/cloudflare": "1.14.0",
    "@tailwindcss/typography": "0.5.15",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "wrangler": "^4.49.1"
  }
}
